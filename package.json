{
  "name": "agentshield-local-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "agentshield-mcp": "mcp/agentshield-mcp.mjs"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "test:sim": "node --test tests/simulator.test.mjs",
    "test:key-scope": "node --test tests/agent-key-scope.test.mjs",
    "test:ai": "node --test tests/near-ai-agent.test.mjs",
    "test:cinematic": "node --test tests/cinematic-evidence.test.mjs",
    "mcp": "node --use-system-ca mcp/agentshield-mcp.mjs"
  },
  "dependencies": {
    "@noble/curves": "1.8.1",
    "@noble/hashes": "1.7.1",
    "near-api-js": "5.1.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ethers": "6.17.0"
  },
  "license": "MIT"
}
