{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "outputs/agentshield-ui",
  "functions": {
    "api/testnet/proof.js": {
      "maxDuration": 60,
      "includeFiles": "{deployment/testnet-live-demo-proposal.json,outputs/testnet-live-payment-evidence.json,outputs/testnet-live-key-evidence.json,outputs/testnet-live-mandate-evidence.json}"
    },
    "api/testnet/gallery.js": {
      "maxDuration": 60,
      "includeFiles": "{deployment/testnet-negative-scenarios-proposal.json,outputs/testnet-negative-*-evidence.json}"
    },
    "api/testnet/counterparty.js": {
      "maxDuration": 30,
      "includeFiles": "{deployment/testnet-live-demo-proposal.json,outputs/agentshield-ui/counterparty.mjs,outputs/agentshield-ui/counterparty-policy.mjs}"
    }
  }
}
